{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "EmPath: extract walking graph",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "scripts/build_scope_walking_graph.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "EmPath: clean pilot data",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "scripts/clean_data.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "EmPath: build maps",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "scripts/visualize.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "EmPath: serve interactive map",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "-m",
        "http.server",
        "8765",
        "--bind",
        "127.0.0.1",
        "--directory",
        "output/scope_screen"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "EmPath: environmental raster pipeline",
      "type": "process",
      "command": "/usr/bin/env",
      "args": [
        "-u",
        "PROJ_DATA",
        "-u",
        "GDAL_DATA",
        "${workspaceFolder}/.venv/bin/python",
        "scripts/environment_pipeline.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "EmPath: package cleaned block and graph datasets",
      "type": "process",
      "command": "/usr/bin/env",
      "args": [
        "-u",
        "PROJ_DATA",
        "-u",
        "GDAL_DATA",
        "${workspaceFolder}/.venv/bin/python",
        "scripts/package_clean_deliverables.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
